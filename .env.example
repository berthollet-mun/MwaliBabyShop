# Frontend (Vercel/local). Laisser vide en local pour utiliser le proxy Vite.
VITE_API_URL=
API_PROXY_TARGET=http://localhost:4000

# API (Render/local)
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_HOURS=8

# PostgreSQL Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
DB_POOL_MAX=10

# Comptes initiaux utilisés uniquement par `npm run db:seed`
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change-me-with-12-characters
RESPONSABLE_EMAIL=responsable@example.com
RESPONSABLE_INITIAL_PASSWORD=change-me-with-12-characters
